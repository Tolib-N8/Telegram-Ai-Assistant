# Telegram API (required)
API_ID=your_api_id
API_HASH=your_api_hash

# Optional: used by phone auth flow in Dashboard
PHONE=+1234567890

# Gemini (required for AI replies / scam checks)
GEMINI_API_KEY=your_gemini_api_key

# Optional: default prompt/model used by assistants if per-account settings are not set
GEMINI_PROMPT="Ты — ассистент."
GEMINI_MODEL=gemini-2.5-flash

# Dashboard auth (recommended)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me

# Optional: cookie/session signing key for Dashboard (recommended to set in production)
# DASHBOARD_SECRET=your_random_secret

# Passkeys/WebAuthn (optional; required for remote devices / https)
# EXPECTED_ORIGIN=https://your-domain.example
# RP_ID=your-domain.example
